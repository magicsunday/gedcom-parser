{
    "name": "magicsunday/gedcom-parser",
    "description": "A streaming, spec-conformant GEDCOM 5.5.1 and 7.0 parser with a fully typed model for PHP 8.3+",
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/magicsunday/gedcom-parser",
    "keywords": [
        "gedcom",
        "gedcom-parser",
        "parser",
        "genealogy",
        "family-tree",
        "ancestry",
        "php"
    ],
    "authors": [
        {
            "name": "Rico Sonntag",
            "email": "mail@ricosonntag.de",
            "homepage": "https://ricosonntag.de",
            "role": "Developer"
        }
    ],
    "config": {
        "bin-dir": ".build/bin",
        "vendor-dir": ".build/vendor",
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "require": {
        "php": "^8.3",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "magicsunday/jsonmapper": "^3.1",
        "phpdocumentor/reflection-docblock": "^5.0 || ^6.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/property-access": "^7.4 || ^8.0",
        "symfony/property-info": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "infection/infection": "^0.32 || ^0.34",
        "magicsunday/coding-standard": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "MagicSunday\\Gedcom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MagicSunday\\Gedcom\\Test\\": "tests/",
            "MagicSunday\\Gedcom\\Tools\\": "tools/"
        }
    },
    "scripts": {
        "ci:cgl": [
            "php-cs-fixer fix --config .php-cs-fixer.dist.php --diff --verbose"
        ],
        "ci:rector": [
            "rector process --config rector.php"
        ],
        "ci:test:php:cgl": [
            "@ci:cgl --dry-run"
        ],
        "ci:test:php:cpd": [
            "node_modules/.bin/jscpd --config .jscpd.json --skip-comments --no-tips --fail-on-empty"
        ],
        "ci:test:php:deptrac": [
            "deptrac analyse --no-progress --cache-file=.build/cache/.deptrac.cache",
            "deptrac debug:unassigned --cache-file=.build/cache/.deptrac.cache",
            "@php -r \"is_dir('.build') || mkdir('.build', 0777, true);\"",
            "deptrac analyse --no-progress --cache-file=.build/cache/.deptrac.cache --formatter=graphviz-dot --output=.build/deptrac-layers.dot",
            "check-deptrac-cycles.php .build/deptrac-layers.dot"
        ],
        "ci:test:php:lint": [
            "phplint --configuration .phplint.yml"
        ],
        "ci:test:php:mutation": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --configuration=infection.json5 --threads=4 --only-covering-test-cases"
        ],
        "ci:test:php:phpstan": [
            "phpstan analyze --configuration phpstan.neon --memory-limit=-1"
        ],
        "ci:test:php:rector": [
            "@ci:rector --dry-run"
        ],
        "ci:test:php:templates": [
            "check-consumer-config.php ."
        ],
        "ci:test:php:unit": [
            "phpunit --configuration phpunit.xml"
        ],
        "ci:test:php:unit:coverage": [
            "XDEBUG_MODE=coverage phpunit --configuration phpunit.xml --coverage-html .build/coverage/"
        ],
        "ci:test": [
            "@ci:test:php:lint",
            "@ci:test:php:unit",
            "@ci:test:php:phpstan",
            "@ci:test:php:rector",
            "@ci:test:php:cgl",
            "@ci:test:php:cpd",
            "@ci:test:php:deptrac",
            "@ci:test:php:templates"
        ]
    }
}
